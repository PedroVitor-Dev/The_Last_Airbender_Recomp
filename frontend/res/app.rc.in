// Icon and version info for the executable (generated by CMake from app.rc.in).
#pragma code_page(65001)
#include <winres.h>

1 ICON "@TLA_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PedroVitor-Dev"
            VALUE "FileDescription", "Avatar: The Last Airbender Recomp"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "AvatarRecomp"
            VALUE "LegalCopyright", "GPL-3.0. Not affiliated with Nickelodeon or THQ."
            VALUE "OriginalFilename", "AvatarRecomp.exe"
            VALUE "ProductName", "Avatar: The Last Airbender Recomp"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
